# 이 파일을 `.env`로 복사한 뒤 본인 값을 채워 사용한다.
# `.env`는 .gitignore 적용되어 절대 커밋되지 않는다.
# spring-dotenv 라이브러리와 Docker Compose 둘 다 이 파일을 자동 로드한다.

# Google AI Studio 키 — https://aistudio.google.com/app/apikey 에서 발급
GOOGLE_API_KEY=AIza-여기에-실제-키-입력

# Postgres 자격증명 (docker-compose가 컨테이너 생성 시 사용 + Spring Boot가 JDBC 연결에 사용).
# 기본값(livelab/livelab/livelab)을 그대로 써도 동작하며, 외부 노출이 없는 로컬 개발이면 충분.
POSTGRES_DB=livelab
POSTGRES_USER=livelab
POSTGRES_PASSWORD=livelab

# 호스트의 Postgres 노출 포트. 기본 5433 — 호스트에 다른 Postgres(예: 로컬 설치 또는 다른 Docker 프로젝트)가
# 5432를 잡고 있을 때 인증 에러로 잘못 보이는 충돌을 회피하기 위해.
POSTGRES_HOST_PORT=5433

# Kafka 호스트 노출 포트. 기본 9092. 다른 Kafka 인스턴스 점유 시 충돌 회피용.
KAFKA_HOST_PORT=9092

# Prometheus / Grafana 노출 포트 (기본 9090 / 3001 — Grafana는 다른 로컬 서비스 점유 회피)
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001

# Google OAuth (블로그 관리자 인증)
# Google Cloud Console → API & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# 마스터 계정 이메일 (이 계정만 블로그 글 작성/수정/삭제 가능)
BLOG_MASTER_EMAIL=your-email@gmail.com
# JWT 서명 키 (32자 이상 랜덤 문자열)
JWT_SECRET=change-me-to-a-random-32-char-string!!

# S3 Storage (NAS MinIO 전환 시 STORAGE_ENDPOINT만 변경)
STORAGE_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
STORAGE_REGION=ap-northeast-2
STORAGE_ACCESS_KEY=AKIA...
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET=livelab-blog
STORAGE_PUBLIC_URL=https://livelab-blog.s3.ap-northeast-2.amazonaws.com
